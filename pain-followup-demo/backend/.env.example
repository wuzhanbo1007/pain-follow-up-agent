DB_HOST=192.168.1.135
DB_PORT=3306
DB_USER=canal
DB_PASSWORD=canal
DB_NAME=pain-followup


# 原 Qwen 配置（备用，切换时取消注释并注释上面三行）
LLM_API_KEY=
LLM_BASE_URL=http://192.168.1.99:8036/v1
LLM_MODEL=Qwen3.6-35B



# 推理模型首轮推理较慢，超时放宽至 180 秒，重试 1 次即可
LLM_TIMEOUT=180
LLM_MAX_RETRIES=1


# ===== 服务配置（FastAPI）=====
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=true

# ===== Embedding 配置（Gitee AI）=====
# 任意 OpenAI 兼容 Embedding 接口（默认走 openai_compatible provider）
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=https://ai.gitee.com/v1
EMBEDDING_API_KEY=
# bge-m3 输出维度为 1024（Gitee AI 与本地一致）
EMBEDDING_DIM=1024

# ===== ES 向量库 =====
ES_HOST=http://192.168.2.210:9200
ES_USERNAME=elastic
ES_PASSWORD=Pass@word
ES_INDEX=pain_guidelines_kb

# ===== Reranker 配置（Gitee AI 云端 bce-reranker）=====
# 提供方 local=本地 bge-reranker-large / gitee=云端 API
RERANKER_PROVIDER=gitee
RERANKER_API_URL=https://ai.gitee.com/v1/sentence-similarity
# Gitee reranker 与 embedding 是不同资源包，此 key 与 EMBEDDING_API_KEY 不同
RERANKER_API_KEY=
RERANKER_MODEL=bce-reranker-base_v1

# ===== 检索参数（RAG 混合检索）=====
RETRIEVE_TOP_K=8
# RRF 融合关键词(BM25)通道权重：>1 更信任关键词命中（过滤语义陷阱文档）
RRF_KEYWORD_WEIGHT=1.8

# ===== Demo 日期固化（演示用）=====
# 锁定判定日期，保证跨天演示时随访名单、数据与当天一致。
# 演示结束后删除此行即可恢复实时日期。
DEMO_TODAY=2026-07-15