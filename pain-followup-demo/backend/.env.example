# LANShing 疼痛智能随访系统后端环境变量示例
#
# 使用方式：复制为 .env 后填写实际连接信息：
#   Windows PowerShell: Copy-Item .env.example .env
#   macOS/Linux:       cp .env.example .env
#
# .env 仅用于本机/部署环境，禁止把真实密钥、数据库密码提交到仓库。

# ===== MySQL 业务数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=painfollowup
DB_PASSWORD=change-me
DB_NAME=pain-followup

# ===== 对话 LLM（OpenAI 兼容接口） =====
# 未配置 LLM_API_KEY 时，随访流程会使用规则/模板降级逻辑。
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:8036/v1
LLM_MODEL=Qwen3.6-35B
LLM_TIMEOUT=180
LLM_MAX_RETRIES=1

# ===== FastAPI + Socket.IO =====
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=true

# ===== RAG Embedding =====
# 可选：openai_compatible、siliconflow、bailian、bge_m3。
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=https://ai.gitee.com/v1
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024

# ===== Elasticsearch =====
ES_HOST=http://127.0.0.1:9200
ES_USERNAME=elastic
ES_PASSWORD=change-me
ES_INDEX=pain_guidelines_kb

# ===== RAG Reranker =====
# gitee 需要 RERANKER_API_KEY；local 需要本地 transformers/torch 模型。
RERANKER_PROVIDER=gitee
RERANKER_API_URL=https://ai.gitee.com/v1/sentence-similarity
RERANKER_API_KEY=
RERANKER_MODEL=bce-reranker-base_v1

# ===== RAG 检索与分块 =====
RETRIEVE_TOP_K=8
RRF_KEYWORD_WEIGHT=1.8
# 不填写 KNOWLEDGE_RAW_DIR 时使用仓库根目录下的 knowledge_base/raw。
# KNOWLEDGE_RAW_DIR=C:/path/to/pain-follow-up-agent/knowledge_base/raw
CHUNK_TARGET_CHARS=800
CHUNK_OVERLAP_CHARS=100
#没用到
PROMPT_EXCERPT_CHARS=400

# ===== 日志（可选） =====
PAINSMART_LOG_LEVEL=INFO
PAINSMART_LOG_DIR=logs
PAINSMART_LOG_FILE=painsmart.log
PAINSMART_LOG_MAX_MB=10
PAINSMART_LOG_BACKUP_COUNT=5

# ===== Demo 业务日期 =====
# 必填，格式 YYYY-MM-DD。要与当前演示数据库/播种数据的业务日期保持一致。
DEMO_TODAY=2026-07-15

# 手动患者、电话回访天数、Checkpointer 等运行规则不在 .env 中配置，
# 请修改 config/followup_runtime.yaml。
