# ===== LLM 配置 =====
# Qwen3.5-35B（OpenAI 兼容接口）
#LLM_API_KEY=lanbigdata-key-1234
#LLM_BASE_URL=http://192.168.1.99:8001/v1/
#LLM_MODEL=Qwen/Qwen3.5-35B-A3B

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# deepseek-chat 为指令模型，直出 JSON、稳定不占推理预算；
# deepseek-v4-flash 为”推理模型”，reasoning 会吃掉 max_tokens 预算，
# 复杂随访计划下正文 JSON 常被挤空/截断 → 走降级模板 → 显示不出真实数值。
LLM_MODEL=deepseek-v4-flash



# 推理模型首轮推理较慢，超时放宽至 120 秒，重试 1 次即可
LLM_TIMEOUT=120
LLM_MAX_RETRIES=1


# ===== 服务配置（FastAPI）=====
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=true

# ===== Embedding 配置（SiliconFlow）=====
# SiliconFlow 提供 OpenAI 兼容的 Embedding 接口
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
# bge-m3 输出维度为 1024（本地 / SiliconFlow 一致）
EMBEDDING_DIM=1024

# ===== Demo 日期固化（演示用）=====
# 锁定判定日期，保证跨天演示时随访名单、数据与当天一致。
# 演示结束后删除此行即可恢复实时日期。
DEMO_TODAY=2026-07-15