            <div class="page-title">
              <h1>  <div>
    <div id="block-cochrane-hs-page-title">
  
    
      
  <span class="title">Statins for chronic obstructive pulmonary disease (COPD)</span>



  </div>

  </div>
</h1>
                          </div>
          </div>
        </div>
      </div>
    </div>
  
    <main id="main-content">
            <div>
    <div data-drupal-messages-fallback class="hidden"></div>
<div id="node-languages">
  <div class="wrap">
    <div class="grid">
      <div class="col-9/13@desktop offset-2/13@desktop offset-reverse-2/13@desktop default-layout">
        <div class="inner">
          <h3>Also available in</h3><ul class="list--buttons"><li><a href="/evidence/CD011959_statins-chronic-obstructive-pulmonary-disease-copd" hreflang="en">English</a></li><li><a href="/es/evidence/CD011959_statins-chronic-obstructive-pulmonary-disease-copd" class="list--button-outline" hreflang="es">Español</a></li><li><a href="/fa/evidence/CD011959_statins-chronic-obstructive-pulmonary-disease-copd" class="list--button-outline" hreflang="fa">فارسی</a></li><li><a href="/fr/evidence/CD011959_statins-chronic-obstructive-pulmonary-disease-copd" class="list--button-outline" hreflang="fr">Français</a></li><li><a href="/ru/evidence/CD011959_statins-chronic-obstructive-pulmonary-disease-copd" class="list--button-outline" hreflang="ru">Русский</a></li><li><a href="/hr/evidence/CD011959_statins-chronic-obstructive-pulmonary-disease-copd" class="list--button-outline" hreflang="hr">Hrvatski</a></li><li><a href="/ms/evidence/CD011959_statins-chronic-obstructive-pulmonary-disease-copd" class="list--button-outline" hreflang="ms">Bahasa Malaysia</a></li><li><a href="/zh-hant/evidence/CD011959_statins-chronic-obstructive-pulmonary-disease-copd" class="list--button-outline" hreflang="zh-hant">繁體中文</a></li><li><a href="/zh-hans/evidence/CD011959_statins-chronic-obstructive-pulmonary-disease-copd" class="list--button-outline" hreflang="zh-hans">简体中文</a></li></ul>
        </div>
